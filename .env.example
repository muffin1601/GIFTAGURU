# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Same URL/anon key, exposed to the browser (the anon key is meant to be
# public -- RLS enforces access, not secrecy). Powers /auth/callback, which
# runs client-side to pick up email-confirmation and password-reset sessions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prisma / PostgreSQL
# Runtime connection. For Supabase, prefer the pooled URL with ?pgbouncer=true.
# URL-encode special characters in passwords, e.g. # becomes %23 and @ becomes %40.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&schema=public"
# Direct connection for Prisma migrations/introspection. For Supabase, use the direct Postgres URL.
# URL-encode special characters in passwords here too.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Razorpay (Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> the secret configured for the
# /api/razorpay/webhook endpoint (order.paid, payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
# Must be a domain verified in Resend (resend.com/domains). Free mailbox
# domains such as gmail.com are rejected as senders.
EMAIL_FROM="Gifta Guru <orders@giftaguru.com>"
# Where order / lead / enquiry notifications are delivered.
ADMIN_EMAIL=giftaguru27@gmail.com

# Base URL used for absolute links in metadata, sitemap, and Razorpay callbacks.
# Production: https://giftaguru.com -- use http://localhost:3000 locally.
SITE_URL=https://giftaguru.com
